{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEONFALL Canonical Major Entity",
  "type": "object",
  "required": [
    "id",
    "name",
    "family",
    "tier",
    "status",
    "role",
    "identity",
    "mechanics",
    "presentation",
    "acquisition",
    "performance",
    "dependencies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(WPN|ARM|REL|MON|WLD|NPC|FAC|BOS|VEH|SKL|CLS|MAT|EVT|POI)-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "family": {
      "type": "string",
      "enum": [
        "weapon",
        "armor",
        "relic",
        "monster",
        "wildlife",
        "npc",
        "faction",
        "boss",
        "vehicle",
        "skill",
        "class",
        "material",
        "event",
        "poi"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary",
        "mythic",
        "exotic",
        "god",
        "absolute",
        "transcendent_zero"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "concept",
        "specified",
        "prototype",
        "implemented",
        "vfx_ready",
        "animation_ready",
        "tested",
        "production"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 3
    },
    "identity": {
      "type": "object",
      "required": [
        "fantasy",
        "silhouette",
        "lore_hook"
      ],
      "properties": {
        "fantasy": {
          "type": "string",
          "minLength": 12
        },
        "silhouette": {
          "type": "string",
          "minLength": 12
        },
        "lore_hook": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "mechanics": {
      "type": "object",
      "required": [
        "core",
        "signature",
        "counterplay"
      ],
      "properties": {
        "core": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "signature": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "counterplay": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evolution": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "required": [
        "vfx",
        "animation",
        "audio"
      ],
      "properties": {
        "vfx": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "animation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "acquisition": {
      "type": "object",
      "required": [
        "method",
        "crafting_links",
        "boss_links",
        "paid"
      ],
      "properties": {
        "method": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "crafting_links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boss_links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paid": {
          "type": "boolean"
        }
      }
    },
    "performance": {
      "type": "object",
      "required": [
        "concurrency_class",
        "vfx_class",
        "replication_class",
        "streaming_locality"
      ],
      "properties": {
        "concurrency_class": {
          "type": "string",
          "enum": [
            "tiny",
            "low",
            "medium",
            "high",
            "event_only"
          ]
        },
        "vfx_class": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "cinematic"
          ]
        },
        "replication_class": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "streaming_locality": {
          "type": "string",
          "enum": [
            "local",
            "regional",
            "global_event"
          ]
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}