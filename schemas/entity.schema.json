{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeonfall.local/schemas/entity.schema.json",
  "title": "AEONFALL Major Entity",
  "type": "object",
  "required": [
    "id","name","family","tier","status","role","identity",
    "mechanics","presentation","acquisition","performance","dependencies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(WPN|ARM|REL|MON|WLD|NPC|FAC|BOS|VEH|SKL|CLS|MAT|EVT|POI)-[0-9]{3}$"
    },
    "name": {"type":"string","minLength":3},
    "family": {
      "enum":["weapon","armor","relic","monster","wildlife","npc","faction","boss","vehicle","skill","class","material","event","poi"]
    },
    "tier": {
      "enum":["common","uncommon","rare","epic","legendary","mythic","exotic","god","absolute","transcendent_zero"]
    },
    "status": {
      "enum":["concept","specified","prototype","implemented","vfx_ready","animation_ready","tested","production"]
    },
    "role": {"type":"string","minLength":3},
    "identity": {
      "type":"object",
      "required":["fantasy","silhouette","lore_hook"],
      "properties":{
        "fantasy":{"type":"string","minLength":12},
        "silhouette":{"type":"string","minLength":12},
        "lore_hook":{"type":"string","minLength":12}
      },
      "additionalProperties":true
    },
    "mechanics": {
      "type":"object",
      "required":["core","signature","counterplay"],
      "properties":{
        "core":{"type":"array","minItems":1,"items":{"type":"string"}},
        "signature":{"type":"array","minItems":1,"items":{"type":"string"}},
        "counterplay":{"type":"array","minItems":1,"items":{"type":"string"}},
        "evolution":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":true
    },
    "presentation": {
      "type":"object",
      "required":["vfx","animation","audio"],
      "properties":{
        "vfx":{"type":"array","items":{"type":"string"}},
        "animation":{"type":"array","items":{"type":"string"}},
        "audio":{"type":"array","items":{"type":"string"}}
      },
      "additionalProperties":true
    },
    "acquisition": {
      "type":"object",
      "required":["method"],
      "properties":{
        "method":{"type":"array","minItems":1,"items":{"type":"string"}},
        "crafting_links":{"type":"array","items":{"type":"string"}},
        "boss_links":{"type":"array","items":{"type":"string"}},
        "paid":{"type":"boolean"}
      },
      "additionalProperties":true
    },
    "performance": {
      "type":"object",
      "required":["concurrency_class","vfx_class","replication_class","streaming_locality"],
      "properties":{
        "concurrency_class":{"enum":["tiny","low","medium","high","event_only"]},
        "vfx_class":{"enum":["low","medium","high","cinematic"]},
        "replication_class":{"enum":["low","medium","high","critical"]},
        "streaming_locality":{"enum":["local","regional","global_event"]}
      },
      "additionalProperties":true
    },
    "dependencies": {
      "type":"array",
      "items":{"type":"string"}
    },
    "notes":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":true
}