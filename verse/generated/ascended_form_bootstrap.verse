aeonfall_ascended_form_bootstrap_device := class(creative_device):

    OnBegin<override>()<suspends>:void=
        for (Definition : AEONFALLAscendedFormDefinitions):
            Registered := AEONFALLAscendedFormRegistry.Register(Definition)
            if (not Registered?):
                AEONFALLRuntimeBus.Emit(
                    aeonfall_runtime_event{
                        EventType := "bootstrap.ascended_form_registration_failed",
                        SourceId := Definition.FormId
                    }
                )

        for (Definition : AEONFALLAscendedFormAbilityDefinitions):
            Registered := AEONFALLAbilityRegistry.Register(Definition)
            if (not Registered?):
                AEONFALLRuntimeBus.Emit(
                    aeonfall_runtime_event{
                        EventType := "bootstrap.ascended_form_ability_registration_failed",
                        SourceId := Definition.AbilityId
                    }
                )
